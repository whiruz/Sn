local SKIN = Color3.fromRGB(240, 200, 160)
local WHITE, BLACK = Color3.new(1, 1, 1), Color3.fromRGB(15, 15, 15)
local PL = Enum.Material.SmoothPlastic

-- kind: s шар, b блок, c вертикальный цилиндр, z цилиндр вдоль Z, x цилиндр вдоль X
local function newP(c, r)
    local model = mk("Model", {Name = "_skin"}, c)
    return function(kind, size, pos, col, rot, mat)
        local p = mk("Part", {
            Size = size, Color = col, Material = mat or PL, CanCollide = false,
            CanTouch = false, CanQuery = false, Massless = true,
        }, model)
        rot = rot or CFrame.new()
        if kind == "s" then mk("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, p)
        elseif kind == "c" then p.Shape = Enum.PartType.Cylinder; rot = CFrame.Angles(0, 0, math.pi / 2) * rot
        elseif kind == "z" then p.Shape = Enum.PartType.Cylinder; rot = CFrame.Angles(0, math.pi / 2, 0) * rot
        elseif kind == "x" then p.Shape = Enum.PartType.Cylinder end
        local w = mk("Weld", {Part0 = r, Part1 = p, C0 = CFrame.new(pos) * rot}, p)
        return p, w
    end
end

local function eyes(P, y, z, dx, sz, col)
    for _, x in ipairs({-dx, dx}) do
        P("s", Vector3.new(sz, sz, sz), Vector3.new(x, y, z), col or WHITE)
        P("s", Vector3.new(sz * 0.45, sz * 0.45, sz * 0.45), Vector3.new(x, y, z - sz * 0.42), BLACK)
    end
end

local function legs(P, xs, y, len, col, shoe)
    for _, x in ipairs(xs) do
        P("c", Vector3.new(len, 0.45, 0.45), Vector3.new(x, y, 0), col)
        P("b", Vector3.new(0.8, 0.4, 1.4), Vector3.new(x, y - len / 2 - 0.1, -0.3), shoe)
    end
end

local function limb(P, L, size, pivot, off, col, ph, mat)
    local _, w = P("b", size, pivot, col, nil, mat)
    L[#L + 1] = {w = w, pivot = pivot, off = off, ph = ph}
end

local function swingUpdate(L)
    return function(t, moving)
        local s = moving and math.sin(t * 10) * 0.8 or 0
        for _, l in ipairs(L) do
            l.w.C0 = CFrame.new(l.pivot) * CFrame.Angles(s * l.ph, 0, 0) * CFrame.new(l.off)
        end
    end
end

