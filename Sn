local curTrack, emoConn
function F.stopEmote()
    if emoConn then emoConn:Disconnect(); emoConn = nil end
    if curTrack then pcall(function() curTrack:Stop() end); curTrack = nil end
end

function F.emote(e)
    F.stopEmote()
    local h = hum()
    if not h then return end
    local id = h.RigType == Enum.HumanoidRigType.R6 and e[3] or e[2]
    local animator = h:FindFirstChildOfClass("Animator") or mk("Animator", {}, h)
    local anim = mk("Animation", {AnimationId = "rbxassetid://" .. id})
    local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok or not tr then return end
    tr.Priority = Enum.AnimationPriority.Action
    tr.Looped = true
    tr:Play()
    tr:AdjustSpeed(S.emSpeed / 100)
    curTrack = tr
    emoConn = RunService.Heartbeat:Connect(function()
        local hh = hum()
        if hh and hh.MoveDirection.Magnitude > 0.1 then F.stopEmote() end
    end)
end

