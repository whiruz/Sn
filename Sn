local function loadWall(txt)
    txt = (txt:gsub("%s", ""))
    if txt:match("roblox%.com") then
        local id = txt:match("(%d%d%d%d+)")
        if id then txt = id end
    end
    if txt:match("^https?://") then
        local ok = pcall(function()
            writefile("sn_wall.png", game:HttpGet(txt))
            wall.Image = getcustomasset("sn_wall.png")
        end)
        return ok
    elseif tonumber(txt) then
        wall.Image = "rbxassetid://" .. txt
        return true
    end
    return false
end

