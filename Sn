local hidden, animConn = {}, nil

local function clearSkin()
    if animConn then animConn:Disconnect(); animConn = nil end
    local c = lp.Character
    if c then
        local m = c:FindFirstChild("_skin")
        if m then m:Destroy() end
    end
    for obj, tr in pairs(hidden) do
        if obj and obj.Parent then obj.Transparency = tr end
    end
    hidden = {}
end

-- Тунг Тунг Тунг Сахур
local function tungSkin(on)
    clearSkin()
    local c, r = lp.Character, root()
    if not (on and c and r) then return end

    for _, o in ipairs(c:GetDescendants()) do
        if (o:IsA("BasePart") and o ~= r) or o:IsA("Decal") then
            hidden[o] = o.Transparency
            o.Transparency = 1
        end
    end

    local model = mk("Model", {Name = "_skin"}, c)
    local WOOD = Color3.fromRGB(166, 112, 62)
    local DARK = Color3.fromRGB(108, 68, 34)
    local LIGHT = Color3.fromRGB(207, 163, 104)
    local STICK = Color3.fromRGB(92, 60, 34)
    local BLACK = Color3.fromRGB(15, 15, 15)
    local WHITE = Color3.fromRGB(250, 250, 250)

    local cyl, ball, blk = Enum.PartType.Cylinder, Enum.PartType.Ball, Enum.PartType.Block
    local UP = CFrame.Angles(0, 0, math.pi / 2)
    local WOODM, PLASTIC = Enum.Material.Wood, Enum.Material.SmoothPlastic

    local function part(shape, size, cf, col, mat)
        local p = mk("Part", {
            Shape = shape, Size = size, Color = col, Material = mat or WOODM,
            CanCollide = false, CanTouch = false, CanQuery = false,
            Massless = true, Anchored = false,
        }, model)
        local w = mk("Weld", {Part0 = r, Part1 = p, C0 = cf}, p)
        return w
    end

    local rig = {}
    local function animated(shape, size, fn, col, mat)
        local w = part(shape, size, CFrame.new(), col, mat)
        rig[#rig + 1] = {w, fn}
    end

    part(cyl, Vector3.new(5, 2.6, 2.6), CFrame.new(0, 0.9, 0) * UP, WOOD)
    part(cyl, Vector3.new(0.15, 2.72, 2.72), CFrame.new(0, -1.25, 0) * UP, DARK)
    part(cyl, Vector3.new(0.15, 2.72, 2.72), CFrame.new(0, 2.5, 0) * UP, DARK)
    part(cyl, Vector3.new(0.20, 2.50, 2.50), CFrame.new(0, 3.45, 0) * UP, LIGHT)
    part(cyl, Vector3.new(0.24, 1.90, 1.90), CFrame.new(0, 3.45, 0) * UP, DARK)
    part(cyl, Vector3.new(0.26, 1.60, 1.60), CFrame.new(0, 3.45, 0) * UP, LIGHT)
    part(cyl, Vector3.new(0.28, 1.00, 1.00), CFrame.new(0, 3.45, 0) * UP, DARK)
    part(cyl, Vector3.new(0.30, 0.50, 0.50), CFrame.new(0, 3.45, 0) * UP, LIGHT)

    for _, x in ipairs({-0.5, 0.5}) do
        part(ball, Vector3.new(1, 1, 1), CFrame.new(x, 1.75, -1.1), WHITE, PLASTIC)
        part(ball, Vector3.new(0.45, 0.45, 0.45), CFrame.new(x * 0.9, 1.7, -1.52), BLACK, PLASTIC)
        part(blk, Vector3.new(0.95, 0.18, 0.14),
            CFrame.new(x, 2.4, -1.12) * CFrame.Angles(0, 0, x > 0 and -0.35 or 0.35), BLACK, PLASTIC)
    end
    part(blk, Vector3.new(1.25, 0.8, 0.12), CFrame.new(0, 0.55, -1.28), BLACK, PLASTIC)
    for _, x in ipairs({-0.45, -0.15, 0.15, 0.45}) do
        part(blk, Vector3.new(0.26, 0.32, 0.1), CFrame.new(x, 0.85, -1.33), WHITE, PLASTIC)
    end

    local ang = {r = 1, l = 0, ll = 0, rl = 0}
    local ARM, LEG = 2.2, 1.55

    local function pivotR() return CFrame.new(1.55, 1.7, 0) * CFrame.Angles(ang.r, 0, 0) end
    local function pivotL() return CFrame.new(-1.55, 1.7, 0) * CFrame.Angles(ang.l, 0, 0) end
    local function batBase() return pivotR() * CFrame.new(0, -ARM, 0) * CFrame.Angles(math.pi / 2, 0, 0) end

    animated(cyl, Vector3.new(ARM, 0.28, 0.28), function() return pivotR() * CFrame.new(0, -ARM / 2, 0) * UP end, STICK)
    animated(ball, Vector3.new(0.5, 0.5, 0.5), function() return pivotR() * CFrame.new(0, -ARM, 0) end, STICK)
    animated(cyl, Vector3.new(1.2, 0.26, 0.26), function() return batBase() * UP end, LIGHT)
    animated(cyl, Vector3.new(2.2, 0.66, 0.66), function() return batBase() * CFrame.new(0, -1.7, 0) * UP end, LIGHT)
    animated(cyl, Vector3.new(0.12, 0.7, 0.7), function() return batBase() * CFrame.new(0, -2.8, 0) * UP end, DARK)

    animated(cyl, Vector3.new(ARM, 0.28, 0.28), function() return pivotL() * CFrame.new(0, -ARM / 2, 0) * UP end, STICK)
    animated(ball, Vector3.new(0.5, 0.5, 0.5), function() return pivotL() * CFrame.new(0, -ARM, 0) end, STICK)

    for _, side in ipairs({{-0.5, "ll"}, {0.5, "rl"}}) do
        local function pv() return CFrame.new(side[1], -1.5, 0) * CFrame.Angles(ang[side[2]], 0, 0) end
        animated(cyl, Vector3.new(LEG, 0.3, 0.3), function() return pv() * CFrame.new(0, -LEG / 2, 0) * UP end, STICK)
        animated(blk, Vector3.new(0.75, 0.35, 1.2), function() return pv() * CFrame.new(0, -LEG, -0.25) end, BLACK, PLASTIC)
        animated(blk, Vector3.new(0.78, 0.12, 1.24), function() return pv() * CFrame.new(0, -LEG - 0.2, -0.25) end, WHITE, PLASTIC)
    end

    animConn = RunService.Heartbeat:Connect(function()
        local h = hum()
        local t = tick()
        local moving = h and h.MoveDirection.Magnitude > 0.1
        if moving then
            local s = math.sin(t * 10)
            ang.r = 0.9 + s * 0.3
            ang.l = -s * 0.8
            ang.ll = s * 0.7
            ang.rl = -s * 0.7
        else
            ang.r = 1.0 + math.max(0, math.sin(t * 7)) * 0.6
            ang.l, ang.ll, ang.rl = 0.05, 0, 0
        end
        for _, e in ipairs(rig) do e[1].C0 = e[2]() end
    end)
end

