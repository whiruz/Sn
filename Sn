local S = {dim = 40, walk = 60, jump = 120, fly = 60, fov = 100, gravity = 196, time = 14, fog = 500, emSpeed = 100}
local F = {}
local state = {}

function F.speed(on) local h = hum(); if h then h.WalkSpeed = on and S.walk or 16 end end
function F.jump(on) local h = hum(); if h then h.UseJumpPower = true; h.JumpPower = on and S.jump or 50 end end
function F.fov(on) cam.FieldOfView = on and S.fov or 70 end
function F.gravity(on) workspace.Gravity = on and S.gravity or 196.2 end

local ncConn
function F.noclip(on)
    if ncConn then ncConn:Disconnect(); ncConn = nil end
    if on then
        ncConn = RunService.Stepped:Connect(function()
            if lp.Character then
                for _, p in ipairs(lp.Character:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
    end
end

local flyConn, bv
function F.fly(on)
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if bv then bv:Destroy(); bv = nil end
    local r = root()
    if on and r then
        bv = mk("BodyVelocity", {MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.zero}, r)
        flyConn = RunService.RenderStepped:Connect(function()
            local h = hum()
            if h and bv then
                local dir = h.MoveDirection
                local up = (h.Jump or UIS:IsKeyDown(Enum.KeyCode.Space)) and 1 or 0
                bv.Velocity = dir * S.fly + Vector3.new(0, up * S.fly + cam.CFrame.LookVector.Y * dir.Magnitude * S.fly, 0)
            end
        end)
    end
end

local ijConn
function F.infJump(on)
    if ijConn then ijConn:Disconnect(); ijConn = nil end
    if on then
        ijConn = UIS.JumpRequest:Connect(function()
            local h = hum()
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
end

function F.esp(on)
    state._esp = on
    task.spawn(function()
        while state._esp do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and not p.Character:FindFirstChild("_esp") then
                    mk("Highlight", {Name = "_esp", FillColor = Color3.fromRGB(190, 90, 255), FillTransparency = 0.6}, p.Character)
                end
            end
            task.wait(1)
        end
        for _, p in ipairs(Players:GetPlayers()) do
            local h = p.Character and p.Character:FindFirstChild("_esp")
            if h then h:Destroy() end
        end
    end)
end

local oldLight
function F.fullbright(on)
    if on then
        oldLight = {Lighting.Brightness, Lighting.ClockTime, Lighting.Ambient}
        Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.Ambient = Color3.new(1, 1, 1)
    elseif oldLight then
        Lighting.Brightness, Lighting.ClockTime, Lighting.Ambient = unpack(oldLight)
    end
end

