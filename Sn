function F.setSkin(name)
    state.skinName = name
    tungSkin(false)
    if dragonFly and name ~= "Дракон" then
        dragonFly = false
        F.fly(state.fly)
    end
    if name == "Тунг Тунг Тунг Сахур" then tungSkin(true); return end
    local c, r = lp.Character, root()
    if not (name and BUILD[name] and c and r) then return end
    for _, o in ipairs(c:GetDescendants()) do
        if (o:IsA("BasePart") and o ~= r) or o:IsA("Decal") then
            hidden[o] = o.Transparency
            o.Transparency = 1
        end
    end
    local upd = BUILD[name](newP(c, r))
    if upd then
        animConn = RunService.Heartbeat:Connect(function()
            local h = hum()
            upd(tick(), h and h.MoveDirection.Magnitude > 0.1)
        end)
    end
    if name == "Дракон" then
        dragonFly = true
        F.fly(true)
    end
end

